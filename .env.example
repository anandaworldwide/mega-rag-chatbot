SITE_ID=yourSitename

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Comma-separated list of allowed dev origins for cross-origin requests
# Only needed if accessing dev server from custom local hostname
# Example: NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=bozos-laptop.local
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Luca (ananda) and Jairam default to grok-4.5 via site-config modelName; enableClaudeAbTest is off.
# XAI_API_KEY is required for those sites. GROK_REASONING_EFFORT defaults to low (TTFB).
# GROK_REASONING_EFFORT=low
#
# Chat always uses cache-friendly prompt layout + answer-first retrieval-tool guidance (code defaults;
# no env flags). Local measurement: web/scripts/ttfb-baseline.mjs, web/scripts/retrieval-curb-quality.mjs
# TTFB_EXPERIMENT=baseline
# Dev also writes web/tmp/dev.log (rotated) + web/tmp/ttfb-metrics.jsonl
# TTFB_METRICS_FILE=0
#
# Legacy model A/B (only if enableClaudeAbTest is re-enabled): sticky 3-arm control / grok-4.5 /
# claude-fable-5 holdout. If AB_TEST_* are unset, defaults are control 62 / Grok 30 / Fable 8.
# If any AB_TEST_* is set, unset siblings default to 0 then normalize. Legacy CLAUDE_AB_TEST_PERCENT
# is ignored for weights. In NODE_ENV=development, assignment is always grok-4.5 (force ignored).
# After graduating to 100% Grok, leave these unset in Vercel (clear any leftover FORCE/PERCENT vars).
# AB_TEST_CONTROL_PERCENT=62
# AB_TEST_GROK_PERCENT=30
# AB_TEST_FABLE_HOLDOUT_PERCENT=8
# AB_TEST_FORCE_MODEL=grok-4.5
# CLAUDE_AB_TEST_FORCE_MODEL=

PINECONE_API_KEY=
PINECONE_INDEX_NAME=test-1
PINECONE_MODEL_NAME=text-embedding-3-large
PINECONE_MODEL_DIMENSIONS=3072
PINECONE_INGEST_INDEX_NAME=test-1
PINECONE_INGEST_MODEL_NAME=text-embedding-3-large
PINECONE_INGEST_MODEL_DIMENSIONS=3072
PINECONE_CLOUD=aws
PINECONE_REGION=us-west-2

# NOTE: every site should have a unique GOOGLE_APPLICATION_CREDENTIALS
GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account",...}
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

SSRF_ALLOWED_DOMAINS=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

SECURE_TOKEN=
SECURE_TOKEN_HASH=

# Make/Salesforce access lookup webhook for Luca access-level sync.
SALESFORCE_ACCESS_LOOKUP_WEBHOOK_URL=
SALESFORCE_API_KEY=
SALESFORCE_API_FIELD_NAME=
SALESFORCE_CONTACT_EMAIL=

# Superuser password to get SU cookie.
# Generate new password with node bin/generateHashedPassword.js new-passwd at cmd line.
# (note, all $ characters need to be escaped)
SUDO_PASSWORD='your generated password here'
# any secret key string for encrypting cookies
SECRET_KEY=

# AWS Stuff -- ananda version, needs to change:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_REGION=

CONTACT_EMAIL=
OPS_ALERT_EMAIL="ops@test.com"
