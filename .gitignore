/experiments/supercut/silence_cache.json

# firestore
/*-debug.log
/emulator-data/

# IDE
/.idea/
.python-version
*.pyc

# dependencies (any depth — /node_modules only matched repo root)
node_modules/
/.pnp
.pnp.js

# testing
/coverage
.pytest_cache/

# Notion wiki resume files from a laptop ingest
data_ingestion/notion/.progress/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.*
!.env.example

# AWS secrets (generated from .env files)
secrets.json

# temporary files
.temp-*
.tmp_*/
# PDF ingest checkpoints. The process deletes them on exit; ignore a leftover from a hard kill.
media/pdf-docs/file_checkpoint*
# YouTube downloads land in the repo root. MP3s in subdirectories stay tracked.
/*.mp3
/*.mp4
/*.mp4.part

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#Notion_db
/Notion_DB

.yarn/

