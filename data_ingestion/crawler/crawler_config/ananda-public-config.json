{
  "domain": "ananda.org",
  "csv_export_url": "http://www.ananda.org/?export_modified_posts=1",
  "csv_modified_days_threshold": 10,
  "skip_patterns": [
    "^/search/",
    "^/login/",
    "^/cart(/|$)",
    "^/account(/|$)",
    "^/my-account(/|$)",
    "^/user-account(/|$)",
    "^/checkout(/|$)",
    "^/wp-admin/",
    "^/wp-login\\.php",
    "^/online-courses/lessons-in-meditation-reviews/",
    "^/autobiography$",
    "^/free-inspiration/books/efl$",
    "^/ask/answerer/",
    "^/video/locations/",
    "^/yogananda-institute/",
    "^/__",
    "void\\(0\\)"
  ],
  "crawl_frequency_days": 25,
  "crawl_delay_seconds": 1
}
