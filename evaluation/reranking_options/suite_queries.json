      "query": "Is there an Ananda center in London?",
      "group": "location",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "min_sources": 0 }
    },
    {
      "id": "hong_sau",
      "query": "How do I practice Hong-Sau?",
      "group": "related",
      "collection": "whole_library",
      "source_count": 3,
