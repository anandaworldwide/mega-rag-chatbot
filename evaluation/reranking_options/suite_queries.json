    {
      "id": "pr222_counseling",
      "query": "What is the Ananda Spiritual Counseling training program, and who teaches it?",
      "group": "auto_author_scope",
      "collection": "auto",
      "source_count": 4,
      "highlight_pr222": true,
      "expect": {
        "min_sources": 1,
        "library_min": { "ananda.org": 2 }
      }
    },
    {
      "id": "inner_renewal",
      "query": "What is the Inner Renewal Retreat and can I attend it online for free?",
      "group": "auto_author_scope",
      "collection": "auto",
      "source_count": 4,
      "expect": {
        "min_sources": 1,
        "library_title_regex": { "ananda.org": "inner renewal" }
      }
    },
    {
      "id": "pr222_screen_time",
      "query": "What does Ananda say about screen time and television for children?",
      "group": "auto_author_scope",
      "collection": "auto",
      "source_count": 4,
      "highlight_pr222": true,
      "expect": {
        "min_sources": 1,
        "library_min": { "ananda.org": 2 }
      }
    },
    {
      "id": "pr222_karma",
      "query": "How do different Ananda teachers explain karma?",
      "group": "auto_author_scope",
      "collection": "auto",
      "source_count": 4,
      "highlight_pr222": true,
      "expect": {
        "min_sources": 2,
        "diverse_teachers": true,
        "exclude_authors_must_not_cover_all": [
          "Paramhansa Yogananda",
          "Swami Kriyananda"
        ]
      }
    },
    {
      "id": "asha_marriage",
      "query": "What has Asha taught about marriage and spiritual partnership?",
      "group": "auto_author_scope",
      "collection": "auto",
      "source_count": 4,
      "extra_filter": { "author": { "$eq": "Asha Nayaswami" } },
      "expect": {
        "min_sources": 1,
        "author_all": "Asha Nayaswami"
      }
    },
    {
      "id": "pr222_matthew5",
      "query": "In this source, what is said about the meek?",
      "group": "title_scope",
      "collection": "whole_library",
      "source_count": 3,
      "highlight_pr222": true,
      "skip_min_retrieval_score": true,
      "title_scope_user_input": "Bible Matthew 5",
      "title_candidates": [
        "The Bible:: New Testament:: Book of Matthew:: Chapter 5",
        "The Bible: New Testament: Book of Matthew: Chapter 5"
      ],
      "expect": {
        "min_sources": 1,
        "title_regex": "Matthew|Chapter 5|Beatitude|meek"
      }
    },
    {
      "id": "matthew5_lahiri_miss",
      "query": "What direct teachings does Lahiri Mahasaya give in this source about destiny?",
      "group": "title_scope",
      "collection": "whole_library",
      "source_count": 3,
      "skip_min_retrieval_score": true,
      "title_scope_user_input": "Bible Matthew 5",
      "title_candidates": [
        "The Bible:: New Testament:: Book of Matthew:: Chapter 5",
        "The Bible: New Testament: Book of Matthew: Chapter 5"
      ],
      "expect": {
        "min_sources": 1,
        "title_regex": "Matthew|Chapter 5"
      }
    },
    {
      "id": "jyotish_attunement",
      "query": "What does Jyotish teach about attunement?",
      "group": "author_filter",
      "collection": "auto",
      "source_count": 4,
      "extra_filter": { "author": { "$eq": "Nayaswami Jyotish Novak" } },
      "expect": {
        "min_sources": 1,
        "author_all": "Nayaswami Jyotish Novak"
      }
    },
    {
      "id": "swami_loyalty_master_swami",
      "query": "What did Swami teach about loyalty?",
      "group": "author_filter",
      "collection": "master_swami",
      "source_count": 4,
      "extra_filter": {
        "author": { "$in": ["Paramhansa Yogananda", "Swami Kriyananda"] }
      },
      "expect": {
        "min_sources": 1,
        "author_in": ["Paramhansa Yogananda", "Swami Kriyananda"]
      }
    },
    {
      "id": "class_planning",
      "query": "I need help planning a class on the Bhagavad Gita",
      "group": "planning",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "min_sources": 0 }
    },
    {
      "id": "swami_loyalty_whole",
      "query": "What did Swami say about loyalty?",
      "group": "related",
      "collection": "whole_library",
      "source_count": 3,
