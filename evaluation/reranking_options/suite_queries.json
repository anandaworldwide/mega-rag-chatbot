{
  "site": "ananda",
  "source": "web/__tests__/site_specific/ananda/semanticSearch.test.ts",
  "npm_script": "npm run test:queries:ananda",
  "notes": [
    "Queries come from the Luca Ananda semantic suite.",
    "PR #222 focus cases are marked highlight_pr222=true.",
    "Title-scope cases skip minRetrievalScore when a live title filter is present."
  ],
  "queries": [
    {
      "id": "name",
      "query": "What is your name?",
      "group": "prompt_only",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "min_sources": 0 }
    },
    {
      "id": "sources_used",
      "query": "What sources do you use for your answers?",
      "group": "prompt_only",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "min_sources": 0 }
    },
    {
      "id": "master_swamiji_meditation",
      "query": "What did Master and Swamiji teach about meditation?",
      "group": "related",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "min_sources": 1 }
    },
    {
      "id": "srf_lessons",
      "query": "What advanced techniques are available in the Self-Realization Fellowship?",
      "group": "related",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "min_sources": 1, "title_regex": "lesson|srf|self-realization|kriya" }
    },
    {
      "id": "ananda_wiki",
      "query": "What is the Ananda Wiki?",
      "group": "prompt_only",
