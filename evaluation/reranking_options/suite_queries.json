      "collection": "whole_library",
      "source_count": 3,
      "expect": { "max_sources": 0 }
    },
    {
      "id": "unrelated_joke",
      "query": "Tell me a joke.",
      "group": "unrelated",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "max_sources": 0 }
    },
    {
      "id": "unrelated_plumber",
      "query": "Recommend a good plumber.",
      "group": "unrelated",
      "collection": "whole_library",
      "source_count": 3,
      "expect": { "max_sources": 0 }
